---
import MapPin from '@lucide/astro/icons/map-pin';
import Clock from '@lucide/astro/icons/clock';
import Phone from '@lucide/astro/icons/phone';
import BrandIcon from '../ui/BrandIcon.astro';
import Michi from '../ui/Michi.astro';
import wordScript from '../../assets/brand/wordmark-script.svg?raw';
import { NAV_ITEMS } from '../../data/content';
import { SITE, whatsappLink } from '../../data/site';
import { homePath, pathFor, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const developerUrl = lang === 'es' ? SITE.developer.urlEs : SITE.developer.urlEn;
const socials = [
  { name: 'facebook', label: 'Facebook', href: SITE.facebook },
  { name: 'tiktok', label: 'TikTok', href: SITE.tiktok },
  { name: 'instagram', label: 'Instagram', href: SITE.instagram },
  { name: 'whatsapp', label: 'WhatsApp', href: whatsappLink() },
] as const;
const visibleSocials = socials.filter((social) => social.href);
---

<footer class="relative bg-chocolate text-crema-logo">
  <div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex -translate-y-[93%] items-end justify-center gap-3 px-4 sm:gap-10" aria-hidden="false">
    <div class="pointer-events-auto w-[30vw] max-w-[13.5rem]">
      <Michi michi="mandarino" poses={['sleep', 'sit']} width={216} bubble={t('michi_meow')} interact="wake" wakeTo="sit" />
    </div>
    <div class="pointer-events-auto w-[36vw] max-w-[16rem]">
      <Michi michi="pivi" poses={['sleep', 'sit']} width={256} bubble={t('michi_meow')} interact="wake" wakeTo="sit" />
    </div>
    <div class="pointer-events-auto w-[30vw] max-w-[13.5rem]">
      <Michi michi="zombie" poses={['sleep', 'sit']} width={216} bubble={t('michi_meow')} interact="wake" wakeTo="sit" />
    </div>
  </div>

  <div class="container-site grid gap-12 pb-12 pt-20 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.2fr]">
    <div class="max-w-sm">
      <a href={homePath(lang)} class="inline-block w-44 text-crema-logo" aria-label="Cioccolato">
        <span class="wm block" set:html={wordScript} />
      </a>
      <p class="mt-5 text-sm leading-relaxed text-crema-logo/75">{t('footer_description')}</p>
      <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-rosa-brillo">{t('footer_social')}</p>
      <ul class="mt-3 flex gap-3">
        {
          visibleSocials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="grid size-11 place-items-center rounded-full border border-crema-logo/20 text-crema-logo transition-all duration-300 hover:-translate-y-1 hover:border-rosa-brillo hover:text-rosa-brillo"
              >
                <BrandIcon name={social.name} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-labelledby="footer-links-title">
      <h2 id="footer-links-title" class="!font-sans text-xs font-bold uppercase tracking-[0.2em] text-rosa-brillo">{t('footer_links')}</h2>
      <ul class="mt-5 space-y-3">
        {
          [{ page: 'home' as const, labelKey: 'nav_home' as const }, ...NAV_ITEMS].map((item) => (
            <li>
              <a href={pathFor(lang, item.page)} class="text-sm text-crema-logo/80 transition-colors hover:text-crema">
                {t(item.labelKey)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="!font-sans text-xs font-bold uppercase tracking-[0.2em] text-rosa-brillo">{t('footer_visit')}</h2>
      <ul class="mt-5 space-y-4 text-sm text-crema-logo/80">
        <li class="flex gap-3">
          <MapPin size={18} class="mt-0.5 shrink-0 text-ambar" />
          <span>
            {SITE.street}<br />{SITE.venue}, {SITE.city}<br />
            <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block font-semibold text-crema underline decoration-rosa-brillo/60 underline-offset-4 hover:text-rosa-brillo">
              {t('footer_map')}
            </a>
          </span>
        </li>
        <li class="flex gap-3">
          <Clock size={18} class="mt-0.5 shrink-0 text-ambar" />
          <span>{t('footer_hours')}<br /><span class="text-crema-logo/60">{t('footer_hours_note')}</span></span>
        </li>
        <li class="flex gap-3">
          <Phone size={18} class="mt-0.5 shrink-0 text-ambar" />
          <a href={SITE.phoneHref} class="font-semibold text-crema hover:text-rosa-brillo">{SITE.phoneDisplay}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-crema-logo/12">
    <div class="container-site flex flex-col gap-2 py-6 pb-24 text-xs text-crema-logo/65 sm:flex-row sm:items-center sm:justify-between sm:pb-6">
      <p>© {year} Cioccolato. {t('footer_rights')}</p>
      <p>
        {t('footer_developed_by')}{' '}
        <a href={developerUrl} target="_blank" rel="noopener" class="font-semibold text-crema underline decoration-rosa-brillo/60 underline-offset-4 transition-colors hover:text-rosa-brillo">
          {SITE.developer.name}
        </a>
      </p>
    </div>
  </div>
</footer>
