---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { sprite } from '../../lib/assets';
import { whatsappLink } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const poses = ['look-up', 'crouch', 'pounce', 'walk', 'swipe', 'sleep'] as const;
const pops = [
  { name: 'obj-cupcake-pink', x: '40%', y: '18%', w: '4.2rem' },
  { name: 'obj-macaron-blue', x: '58%', y: '2%', w: '4.6rem' },
  { name: 'obj-donut', x: '72%', y: '30%', w: '4.6rem' },
  { name: 'obj-croissant', x: '86%', y: '10%', w: '5rem' },
  { name: 'obj-cake-strawberry', x: '8%', y: '58%', w: '4.4rem' },
];
---

<section class="interlude" data-interlude aria-labelledby="interlude-title">
  <div class="interlude-sticky">
    <div class="stars"></div>
    <div class="pointer-events-none absolute left-1/2 top-[38%] size-[34rem] max-w-[90vw] -translate-x-1/2 rounded-full bg-rosa/20 blur-[110px]"></div>

    <div class="container-site relative z-10 pt-24 sm:pt-28">
      <div class="il-copy il-copy-intro max-w-xl">
        <p class="eyebrow">{t('interlude_eyebrow')}</p>
        <h2 id="interlude-title" class="display-title mt-4">{t('interlude_title')}</h2>
        <p class="lead mt-4">{t('interlude_text')}</p>
      </div>
      <div class="il-copy il-copy-end max-w-xl" aria-live="polite">
        <h2 class="display-title">{t('interlude_end_title')}</h2>
        <p class="lead mt-4">{t('interlude_end_text')}</p>
        <a href={whatsappLink(t('whatsapp_default_message'))} target="_blank" rel="noopener" class="btn btn-primary mt-6">
          {t('interlude_cta')}
          <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="il-stage" aria-hidden="true">
      <svg class="il-thread" preserveAspectRatio="none"><path d="" fill="none" /></svg>
      <span class="il-hook"></span>
      <div class="il-floor"></div>
      {
        pops.map((pop, index) => (
          <Image
            src={sprite(pop.name)}
            alt=""
            width={96}
            densities={[1, 2]}
            loading="lazy"
            class="sprite il-pop"
            style={`--x:${pop.x};--y:${pop.y};--w:${pop.w};--i:${index}`}
          />
        ))
      }
      <div class="il-pivi">
        {
          poses.map((pose) => (
            <Image
              src={sprite(`pivi-${pose}`)}
              alt=""
              width={320}
              densities={[1, 2]}
              loading="lazy"
              class="sprite il-pose"
              data-pose={pose}
              data-active={pose === 'sleep' ? '' : undefined}
            />
          ))
        }
      </div>
      <div class="il-ball">
        <Image src={sprite('obj-yarn-pink')} alt="" width={90} densities={[1, 2]} loading="lazy" class="sprite size-full object-contain" />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .interlude {
    position: relative;
    height: 340svh;
    background: var(--color-cacao);
    color: var(--color-crema-logo);
  }

  .interlude[data-static] {
    height: auto;
  }

  .interlude-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .interlude[data-static] .interlude-sticky {
    position: relative;
    height: min(100svh, 46rem);
  }

  .il-copy {
    transition:
      opacity 0.6s ease,
      transform 0.7s var(--ease-out-expo);
  }

  .il-copy-end {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    top: 6rem;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .il-copy-end {
      left: 2rem;
      right: auto;
    }
  }

  @media (min-width: 1024px) {
    .il-copy-end {
      left: 2.5rem;
    }
  }

  .interlude[data-end] .il-copy-intro {
    opacity: 0;
    transform: translateY(-16px);
  }

  .interlude[data-end] .il-copy-end {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .il-stage {
    position: absolute;
    inset: auto 0 5rem 0;
    height: min(58svh, 36rem);
  }

  @media (min-width: 640px) {
    .il-stage {
      bottom: 1.5rem;
      height: min(64svh, 36rem);
    }
  }

  .il-thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .il-thread path {
    stroke: var(--color-rosa-brillo);
    stroke-width: 3;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-rosa-brillo) 80%, transparent));
  }

  .il-hook {
    position: absolute;
    left: 10%;
    top: 3%;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: var(--color-ambar);
    box-shadow: 0 0 18px var(--color-ambar);
  }

  .il-floor {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--color-crema-logo) 40%, transparent), transparent);
  }

  .il-ball {
    position: absolute;
    left: 0;
    top: 0;
    width: 3.2rem;
    height: 3.2rem;
    will-change: transform;
  }

  .il-pivi {
    position: absolute;
    left: 0;
    top: 0;
    width: 15rem;
    height: 11rem;
    will-change: transform;
  }

  .il-pose {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    opacity: 0;
  }

  .il-pose[data-active] {
    opacity: 1;
  }

  .il-pop {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: auto;
    opacity: 0;
    transform: scale(0) rotate(-30deg);
  }

  .interlude[data-end] .il-pop {
    animation: il-pop 0.8s var(--ease-spring) forwards;
    animation-delay: calc(var(--i) * 110ms + 150ms);
  }

  @keyframes il-pop {
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  .interlude:not([data-js]) .il-pivi {
    left: 56%;
    top: auto;
    bottom: 0;
  }

  .interlude:not([data-js]) .il-ball {
    left: 52%;
    top: auto;
    bottom: 0.2rem;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-interlude]');
  if (section) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stage = section.querySelector<HTMLElement>('.il-stage')!;
    const thread = section.querySelector<SVGSVGElement>('.il-thread')!;
    const path = thread.querySelector('path')!;
    const hook = section.querySelector<HTMLElement>('.il-hook')!;
    const pivi = section.querySelector<HTMLElement>('.il-pivi')!;
    const ball = section.querySelector<HTMLElement>('.il-ball')!;

    new IntersectionObserver(
      (entries, observer) => {
        if (!entries[0].isIntersecting) return;
        section.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((image) => (image.loading = 'eager'));
        observer.disconnect();
      },
      { rootMargin: '120% 0px' },
    ).observe(section);

    if (reduce) {
      section.setAttribute('data-static', '');
      section.setAttribute('data-end', '');
    } else {
      section.setAttribute('data-js', '');
      let width = 0;
      let height = 0;
      let pw = 0;
      let ballSize = 0;
      const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));
      const ease = (value: number) => (value < 0.5 ? 4 * value ** 3 : 1 - (-2 * value + 2) ** 3 / 2);
      const smooth = (a: number, b: number, value: number) => ease(clamp((value - a) / (b - a)));

      const measure = () => {
        width = stage.clientWidth;
        height = stage.clientHeight;
        pw = clamp(width * 0.36, 150, 300);
        ballSize = clamp(width * 0.075, 38, 66);
        pivi.style.width = `${pw}px`;
        pivi.style.height = `${pw * 0.74}px`;
        ball.style.width = ball.style.height = `${ballSize}px`;
        thread.setAttribute('viewBox', `0 0 ${width} ${height}`);
      };

      let lastPose = '';
      const render = (p: number) => {
        const travel = ease(clamp(p / 0.9));
        const bx = width * (0.4 + 0.46 * travel);
        const hop = p > 0.12 && p < 0.88 ? Math.abs(Math.sin(p * Math.PI * 9)) * height * 0.1 : 0;
        const by = height - ballSize - hop;
        const catchUp = smooth(0.78, 0.96, p);
        const px = bx - pw * (1.1 - 0.3 * catchUp);
        let pose = 'sleep';
        let lift = 0;
        if (p < 0.08) pose = 'look-up';
        else if (p < 0.22) pose = 'crouch';
        else if (p < 0.78) {
          const phase = (p * 7) % 1;
          pose = phase < 0.5 ? 'pounce' : 'walk';
          lift = phase < 0.5 ? Math.sin(phase * 2 * Math.PI) * height * 0.07 : Math.sin(phase * 4 * Math.PI) * 4;
        } else if (p < 0.9) pose = 'swipe';
        if (pose !== lastPose) {
          pivi.querySelectorAll<HTMLElement>('.il-pose').forEach((image) => image.toggleAttribute('data-active', image.dataset.pose === pose));
          lastPose = pose;
        }
        pivi.style.transform = `translate3d(${px}px, ${height - pivi.offsetHeight - lift}px, 0)`;
        ball.style.transform = `translate3d(${bx - ballSize / 2}px, ${by}px, 0) rotate(${(bx / ballSize) * 57}deg)`;
        const ax = hook.offsetLeft;
        const ay = hook.offsetTop;
        const tx = bx;
        const ty = by + ballSize / 2;
        const tension = clamp(Math.hypot(tx - ax, ty - ay) / (width * 1.05));
        const sag = (1 - tension) * height * 0.6 + 18;
        path.setAttribute('d', `M${ax} ${ay} Q${(ax + tx) / 2} ${(ay + ty) / 2 + sag} ${tx} ${ty}`);
        section.toggleAttribute('data-end', p > 0.9);
      };

      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = section.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        render(clamp(total > 0 ? -rect.top / total : 0));
      };
      const request = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      measure();
      update();
      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', () => {
        measure();
        request();
      });
    }
  }
</script>
