---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import Truck from '@lucide/astro/icons/truck';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import HeroTrio from './HeroTrio.astro';
import Words from '../ui/Words.astro';
import { pathFor, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const quoteHref = `${pathFor(lang, 'contact')}#cotizar`;
const chips = [
  { icon: BadgeCheck, key: 'hero_chip_experience' },
  { icon: Truck, key: 'hero_chip_delivery' },
  { icon: CalendarDays, key: 'hero_chip_advance' },
] as const;
const titleWords = t('hero_title_a').split(/\s+/).filter(Boolean);
const titleTail = titleWords.pop() ?? '';
const titleHead = titleWords.join(' ');
---

<section id="hero" class="surface-dark relative isolate overflow-hidden" data-fab-hide="band" aria-labelledby="hero-title">
  <div class="stars"></div>
  <div class="pointer-events-none absolute -right-24 top-24 -z-10 size-[34rem] rounded-full bg-rosa/30 blur-[120px]"></div>
  <div class="pointer-events-none absolute -left-32 bottom-0 -z-10 size-[26rem] rounded-full bg-naranja/18 blur-[110px]"></div>

  <div class="container-site grid items-center gap-2 pb-16 pt-20 sm:gap-4 sm:pb-20 sm:pt-28 lg:min-h-[100svh] lg:grid-cols-[1.12fr_0.88fr] lg:gap-8 lg:pb-16 lg:pt-24">
    <div class="order-2 min-w-0 lg:order-1">
      <p class="eyebrow" data-enter style="--i:0">{t('hero_eyebrow')}</p>
      <h1 id="hero-title" class="words mt-4 text-[clamp(2.35rem,4.9vw,4.3rem)] sm:mt-5 font-semibold leading-[1.04]" data-enter style="--i:1">
        <Words text={titleHead} />{' '}<span class="whitespace-nowrap"
          ><Words text={titleTail} start={titleWords.length} />{' '}<span class="word"
            ><span class="hero-accent" style={`--w:${titleWords.length + 1}`}>{t('hero_title_b')}</span></span
          ></span
        >
      </h1>
      <p class="lead mt-4 max-w-xl sm:mt-6" data-enter style="--i:4">{t('hero_subtitle')}</p>
      <div class="mt-7 flex flex-wrap gap-3 sm:mt-9 sm:gap-4" data-enter="pop" style="--i:5">
        <a href={quoteHref} class="btn btn-primary">{t('hero_cta_quote')}</a>
        <a href={pathFor(lang, 'gallery')} class="btn btn-ghost">{t('hero_cta_gallery')}</a>
      </div>
      <ul class="hero-chips mt-8 flex gap-3 sm:mt-10 sm:flex-wrap" data-enter style="--i:6">
        {
          chips.map((chip) => (
            <li class="chip">
              <chip.icon size={16} class="text-ambar" aria-hidden="true" />
              {t(chip.key)}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="order-1 lg:order-2">
      <HeroTrio lang={lang} />
    </div>
  </div>

  <a href="#servicios" class="hero-cue absolute bottom-5 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 text-xs font-bold uppercase tracking-[0.2em] text-crema-logo/60 transition-colors hover:text-crema lg:flex">
    {t('hero_scroll')}
    <ArrowDown size={16} class="animate-bounce" />
  </a>
</section>

<style>
  .hero-accent {
    background: linear-gradient(95deg, var(--color-rosa-brillo), var(--color-ambar) 55%, var(--color-rosa-brillo));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }

  @media (max-width: 639px) {
    .hero-chips {
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 1.25rem;
      scrollbar-width: none;
    }

    .hero-chips::-webkit-scrollbar {
      display: none;
    }

    .hero-chips .chip {
      flex: none;
      scroll-snap-align: start;
    }
  }
</style>
