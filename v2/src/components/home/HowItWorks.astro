---
import { Image } from 'astro:assets';
import { sprite } from '../../lib/assets';
import { HOW_STEPS } from '../../data/content';
import { useTranslations, type Lang, type UIKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const icons = ['obj-cupcake-yellow', 'obj-macaron-pink', 'obj-croissant', 'obj-cake-rainbow'];
---

<section class="section" aria-labelledby="how-title">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">{t('how_eyebrow')}</p>
      <h2 id="how-title" class="display-title mt-4">{t('how_title')}</h2>
    </div>

    <ol class="how-steps relative mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        HOW_STEPS.map((step, index) => (
          <li class="relative text-center" data-reveal style={`--d:${index}`}>
            <div class="step-badge relative mx-auto grid size-28 place-items-center rounded-full bg-cacao ring-[6px] ring-crema">
              <Image src={sprite(icons[index])} alt="" width={72} densities={[1, 2]} loading="lazy" class="sprite h-auto w-[4.5rem]" />
              <span class="absolute -left-1 -top-1 grid size-9 place-items-center rounded-full bg-rosa-brillo font-display text-lg font-bold text-cacao">{step}</span>
            </div>
            <h3 class="mt-6 text-[1.3rem]">{t(`how_${step}_title` as UIKey)}</h3>
            <p class="mx-auto mt-2 max-w-[17rem] text-[0.97rem] text-chocolate/75">{t(`how_${step}_text` as UIKey)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .how-steps::before {
      content: "";
      position: absolute;
      top: 3.5rem;
      left: 12.5%;
      right: 12.5%;
      border-top: 2px dashed color-mix(in srgb, var(--color-chocolate) 28%, transparent);
    }
  }

  .step-badge {
    transition: transform 0.5s var(--ease-spring);
  }

  li:hover .step-badge {
    transform: translateY(-6px) rotate(-4deg);
  }
</style>
