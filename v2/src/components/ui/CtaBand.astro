---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Michi from './Michi.astro';
import Words from './Words.astro';
import { sprite } from '../../lib/assets';
import { whatsappLink } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  michi?: 'pivi' | 'mandarino' | 'zombie';
  pose?: string;
}

const { lang, michi = 'pivi', pose = 'swipe' } = Astro.props;
const t = useTranslations(lang);
const floaters = [
  { name: 'obj-macaron-pink', class: 'left-[2%] top-[8%] w-16 sm:w-20', delay: '0s' },
  { name: 'obj-cupcake-yellow', class: 'right-[4%] top-[4%] w-14 sm:w-16', delay: '1.2s' },
  { name: 'obj-donut', class: 'right-[10%] bottom-[10%] w-16 sm:w-20', delay: '0.6s' },
];
---

<section class="surface-dark section relative overflow-hidden" aria-labelledby="cta-title">
  <div class="stars"></div>
  <div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-[42rem] max-w-full -translate-x-1/2 rounded-full bg-rosa/25 blur-[100px]"></div>
  <div class="container-site relative grid items-center gap-10 pb-10 md:grid-cols-[1.15fr_0.85fr] md:pb-14">
    <div data-reveal>
      <h2 id="cta-title" class="words display-title text-balance" data-reveal><Words text={t('cta_title')} /></h2>
      <p class="lead mt-5 max-w-xl">{t('cta_text')}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={whatsappLink(t('whatsapp_default_message'))} target="_blank" rel="noopener" class="btn btn-primary">
          {t('cta_button')}
          <ArrowUpRight size={18} />
        </a>
      </div>
      <p class="mt-5 text-sm text-crema-logo/65">{t('cta_note')}</p>
    </div>
    <div class="relative mx-auto w-full max-w-sm" data-reveal style="--d:2">
      {
        floaters.map((item) => (
          <Image
            src={sprite(item.name)}
            alt=""
            width={96}
            densities={[1, 2]}
            loading="lazy"
            class={`sprite absolute z-0 h-auto ${item.class}`}
            style={`animation: float-y 4s ease-in-out ${item.delay} infinite alternate`}
          />
        ))
      }
      <div class="relative z-10 flex justify-center">
        <Michi michi={michi} poses={[pose]} width={330} />
      </div>
    </div>
  </div>
</section>
