---
import { Image } from 'astro:assets';
import cats from '../../assets/brand/trio-gatos.webp';
import sweets from '../../assets/brand/trio-postres.webp';

interface Props {
  alt: string;
}

const { alt } = Astro.props;
const SIZES = '(min-width: 1024px) 256px, 232px';
---

<div class="trio-portrait relative aspect-[1600/1498] w-full" role="img" aria-label={alt}>
  <Image src={sweets} alt="" widths={[320, 480, 640]} sizes={SIZES} quality={70} loading="eager" class="trio-layer trio-sweets" />
  <Image src={cats} alt="" widths={[320, 480, 640]} sizes={SIZES} quality={74} loading="eager" fetchpriority="high" class="trio-layer trio-cats" />
</div>

<style is:global>
  .trio-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    user-select: none;
    pointer-events: none;
  }

  .trio-sweets {
    animation: trio-float 6s ease-in-out infinite alternate;
  }

  .trio-cats {
    animation: trio-float 5s ease-in-out -1.6s infinite alternate;
  }

  @keyframes trio-float {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-6px);
    }
  }
</style>
