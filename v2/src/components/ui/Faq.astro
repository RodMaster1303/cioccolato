---
import Plus from '@lucide/astro/icons/plus';
import PeekCat from './PeekCat.astro';
import { FAQ_ITEMS } from '../../data/content';
import { useTranslations, type Lang, type UIKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="relative mx-auto max-w-3xl">
  <PeekCat michi="pivi" beat="-1.3s" class="bottom-[calc(100%-12px)] right-6 w-28 sm:right-10 sm:w-36" />
  <div class="relative z-10 divide-y divide-chocolate/15 rounded-3xl border border-chocolate/12 bg-white px-6 shadow-[0_18px_40px_-30px_rgb(42_23_16/0.5)] sm:px-8">
    {
      FAQ_ITEMS.map((id) => (
        <details class="faq group py-1" data-reveal>
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-display text-[1.12rem] font-semibold text-chocolate">
            {t(`faq_${id}_q` as UIKey)}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-cacao text-rosa-brillo transition-transform duration-500 ease-[var(--ease-spring)] group-open:rotate-[135deg]">
              <Plus size={16} aria-hidden="true" />
            </span>
          </summary>
          <p class="pb-5 pr-10 text-chocolate/80">{t(`faq_${id}_a` as UIKey)}</p>
        </details>
      ))
    }
  </div>
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
