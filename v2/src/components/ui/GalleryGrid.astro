---
import { Image, getImage } from 'astro:assets';
import X from '@lucide/astro/icons/x';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ZoomIn from '@lucide/astro/icons/zoom-in';
import gallery from '../../data/gallery.json';
import { photo } from '../../lib/assets';
import { GALLERY_CATEGORIES } from '../../data/content';
import { useTranslations, type Lang, type UIKey } from '../../i18n';

interface Props {
  lang: Lang;
  featuredOnly?: boolean;
  filters?: boolean;
}

const { lang, featuredOnly = false, filters = false } = Astro.props;
const t = useTranslations(lang);
const entries = featuredOnly ? gallery.filter((entry) => entry.featured) : gallery;
const items = await Promise.all(
  entries.map(async (entry) => {
    const meta = photo(entry.file);
    const full = await getImage({ src: meta, width: Math.min(1600, meta.width), format: 'webp', quality: 82 });
    return { ...entry, meta, full: full.src, alt: lang === 'es' ? entry.es : entry.en };
  }),
);
---

{
  filters && (
    <div role="group" aria-label={t('gallery_filters')} class="mb-10 flex flex-wrap justify-center gap-2.5">
      <button type="button" data-filter="all" aria-pressed="true" class="filter-chip">
        {t('gallery_all')}
      </button>
      {GALLERY_CATEGORIES.map((category) => (
        <button type="button" data-filter={category} aria-pressed="false" class="filter-chip">
          {t(`gallery_cat_${category}` as UIKey)}
        </button>
      ))}
    </div>
  )
}

<ul class="gallery-cols">
  {
    items.map((item, index) => (
      <li class="gallery-item" data-category={item.category} data-reveal style={`--d:${index % 3}`}>
        <button
          type="button"
          data-lightbox
          data-full={item.full}
          data-alt={item.alt}
          class="group relative block w-full overflow-hidden rounded-2xl bg-crema-2 shadow-[0_18px_36px_-24px_rgb(42_23_16/0.7)]"
          aria-label={item.alt}
        >
          <Image
            src={item.meta}
            alt=""
            widths={[360, 560, 800]}
            sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
            loading="lazy"
            decoding="async"
            class="h-auto w-full transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
          />
          <span class="pointer-events-none absolute inset-0 flex items-end justify-end bg-gradient-to-t from-cacao/55 via-transparent to-transparent p-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
            <span class="grid size-10 place-items-center rounded-full bg-crema text-chocolate">
              <ZoomIn size={18} aria-hidden="true" />
            </span>
          </span>
        </button>
      </li>
    ))
  }
</ul>

<dialog
  id="lightbox"
  aria-label={t('lightbox_label')}
  class="m-auto max-h-[94dvh] w-[min(96vw,70rem)] max-w-none overflow-visible border-0 bg-transparent p-0 text-crema backdrop:bg-cacao/92 backdrop:backdrop-blur-sm"
>
  <figure class="relative">
    <img id="lightbox-img" alt="" class="mx-auto max-h-[80dvh] w-auto max-w-full rounded-2xl object-contain shadow-2xl" />
    <figcaption id="lightbox-caption" class="mt-4 px-12 text-center text-sm text-crema-logo/85"></figcaption>
  </figure>
  <button type="button" data-lightbox-close aria-label={t('lightbox_close')} class="lb-btn right-2 top-2">
    <X size={22} />
  </button>
  <button type="button" data-lightbox-prev aria-label={t('lightbox_prev')} class="lb-btn left-1 top-1/2 -translate-y-1/2 sm:-left-5">
    <ChevronLeft size={24} />
  </button>
  <button type="button" data-lightbox-next aria-label={t('lightbox_next')} class="lb-btn right-1 top-1/2 -translate-y-1/2 sm:-right-5">
    <ChevronRight size={24} />
  </button>
</dialog>

<style is:global>
  .gallery-cols {
    column-gap: 1rem;
    columns: 2;
  }

  @media (min-width: 1024px) {
    .gallery-cols {
      column-gap: 1.25rem;
      columns: 3;
    }
  }

  .gallery-item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  @media (min-width: 1024px) {
    .gallery-item {
      margin-bottom: 1.25rem;
    }
  }

  .gallery-item[hidden] {
    display: none;
  }

  .filter-chip {
    min-height: 2.75rem;
    padding: 0.55rem 1.3rem;
    border-radius: 9999px;
    border: 2px solid color-mix(in srgb, var(--color-chocolate) 25%, transparent);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-chocolate);
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s,
      transform 0.3s var(--ease-spring);
  }

  .filter-chip:hover {
    border-color: var(--color-chocolate);
    transform: translateY(-2px);
  }

  .filter-chip[aria-pressed="true"] {
    background: var(--color-chocolate);
    border-color: var(--color-chocolate);
    color: var(--color-crema);
  }

  .lb-btn {
    position: absolute;
    z-index: 3;
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-cacao) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-crema-logo) 30%, transparent);
    color: var(--color-crema);
    backdrop-filter: blur(6px);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .lb-btn:hover {
    background: var(--color-rosa-brillo);
    color: var(--color-cacao);
  }

  #lightbox[open] {
    animation: lb-in 0.35s var(--ease-out-expo);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
</style>

<script>
  const dialog = document.getElementById('lightbox');
  if (dialog instanceof HTMLDialogElement) {
    const image = dialog.querySelector<HTMLImageElement>('#lightbox-img')!;
    const caption = dialog.querySelector<HTMLElement>('#lightbox-caption')!;
    let triggers: HTMLElement[] = [];
    let index = 0;

    const show = (next: number) => {
      index = (next + triggers.length) % triggers.length;
      const trigger = triggers[index];
      image.src = trigger.dataset.full ?? '';
      image.alt = trigger.dataset.alt ?? '';
      caption.textContent = trigger.dataset.alt ?? '';
      [triggers[(index + 1) % triggers.length], triggers[(index - 1 + triggers.length) % triggers.length]].forEach((neighbor) => {
        const preload = new Image();
        preload.src = neighbor.dataset.full ?? '';
      });
    };

    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      const trigger = target.closest<HTMLElement>('[data-lightbox]');
      if (trigger) {
        triggers = [...document.querySelectorAll<HTMLElement>('[data-lightbox]')].filter((element) => !element.closest('[hidden]'));
        show(triggers.indexOf(trigger));
        dialog.showModal();
        return;
      }
      if (target === dialog || target.closest('[data-lightbox-close]')) dialog.close();
      else if (target.closest('[data-lightbox-prev]')) show(index - 1);
      else if (target.closest('[data-lightbox-next]')) show(index + 1);
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    dialog.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
    });
    dialog.addEventListener('pointerup', (event) => {
      const delta = event.clientX - startX;
      if (Math.abs(delta) > 60 && event.pointerType === 'touch') show(index + (delta < 0 ? 1 : -1));
    });
  }

  const chips = document.querySelectorAll<HTMLElement>('[data-filter]');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const value = chip.dataset.filter;
      chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
      document.querySelectorAll<HTMLElement>('.gallery-item').forEach((item) => {
        item.toggleAttribute('hidden', value !== 'all' && item.dataset.category !== value);
      });
    });
  });
</script>
