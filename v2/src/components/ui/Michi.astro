---
import { Image } from 'astro:assets';
import { catPose, sprite } from '../../lib/assets';

interface Props {
  michi: string;
  poses: string[];
  width: number;
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  bubble?: string;
  interact?: 'meow' | 'wake' | 'none';
  wakeTo?: string;
  routine?: boolean;
  sizes?: string;
}

const { michi, poses, width, alt = '', class: className = '', loading = 'lazy', bubble, interact = 'none', wakeTo, routine = false, sizes } = Astro.props;
const normalized = poses.length > 1;
const first = sprite(`${michi}-${poses[0]}`);
const ratio = normalized ? '1 / 1' : `${first.width} / ${first.height}`;
---

<span
  class:list={['michi relative inline-block align-bottom', className]}
  data-michi={michi}
  data-interact={interact}
  data-wake={wakeTo}
  data-norm={normalized ? '' : undefined}
  data-routine={routine ? '' : undefined}
  style={`width:min(${width}px,100%);aspect-ratio:${ratio}`}
>
  {
    poses.map((pose, index) =>
      normalized ? (
        <Image
          src={catPose(`${michi}-${pose}`)}
          alt={index === 0 ? alt : ''}
          widths={[240, 360, 540, 720]}
          sizes={sizes ?? `(max-width: 640px) 70vw, ${Math.round(width * 1.16)}px`}
          quality={66}
          loading={index === 0 ? loading : 'lazy'}
          fetchpriority={index === 0 && loading === 'eager' ? 'high' : undefined}
          decoding="async"
          class="sprite michi-pose absolute inset-0 size-full"
          data-pose={pose}
          data-active={index === 0 ? '' : undefined}
        />
      ) : (
        <Image
          src={sprite(`${michi}-${pose}`)}
          alt={index === 0 ? alt : ''}
          width={width}
          densities={[1, 2]}
          loading={index === 0 ? loading : 'lazy'}
          fetchpriority={index === 0 && loading === 'eager' ? 'high' : undefined}
          decoding="async"
          class="sprite michi-pose absolute bottom-0 left-0 h-auto w-full"
          data-pose={pose}
          data-active={index === 0 ? '' : undefined}
        />
      ),
    )
  }
  {bubble && <span class="michi-bubble" aria-hidden="true">{bubble}</span>}
</span>

<style is:global>
  .michi-pose {
    opacity: 0;
    transition: opacity 0.12s linear;
  }

  .michi-pose[data-active] {
    opacity: 1;
  }

  .michi[data-norm] .michi-pose {
    transform: translateY(7%) scale(1.163);
    transform-origin: 50% 100%;
  }

  .michi[data-interact]:not([data-interact="none"]) {
    cursor: pointer;
  }

  .michi-bubble {
    position: absolute;
    left: 50%;
    top: -0.4rem;
    z-index: 5;
    translate: -50% 0;
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
    background: var(--color-crema);
    color: var(--color-chocolate);
    font-size: 0.85rem;
    font-weight: 800;
    white-space: nowrap;
    box-shadow: 0 6px 18px -6px rgb(0 0 0 / 0.55);
    opacity: 0;
    pointer-events: none;
  }

  .michi-bubble::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -5px;
    width: 10px;
    height: 10px;
    translate: -50% 0;
    rotate: 45deg;
    background: inherit;
    border-radius: 2px;
  }

  .michi[data-talking] .michi-bubble {
    animation: bubble-pop 1.4s ease forwards;
  }
</style>
