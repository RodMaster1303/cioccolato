---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CupSoda from '@lucide/astro/icons/cup-soda';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import MacaronKnock from '../components/ui/MacaronKnock.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Michi from '../components/ui/Michi.astro';
import { MENU_CATEGORIES } from '../data/content';
import { whatsappLink } from '../data/site';
import { photo } from '../lib/assets';
import { useTranslations, type Lang, type UIKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout lang={lang} page="menu" title={`${t('page_title_menu')} | Cioccolato`} description={t('meta_description_menu')}>
  <PageHeader title={t('page_title_menu')} text={t('menu_page_text')}>
    <Michi slot="art" michi="pivi" poses={['sit', 'meow']} width={230} interact="meow" bubble={t('michi_meow')} />
  </PageHeader>

  <section class="section pt-20 sm:pt-28">
    <div class="container-site">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          MENU_CATEGORIES.map((category, index) => {
            const title = t(`menu_${category.id}_title` as UIKey);
            return (
              <li data-reveal style={`--d:${index % 3}`}>
                <article class="card group flex h-full flex-col overflow-hidden">
                  <div class="relative aspect-[4/3] overflow-hidden bg-cacao">
                    {category.photo ? (
                      <Image
                        src={photo(category.photo)}
                        alt=""
                        widths={[420, 640, 900]}
                        sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
                        loading="lazy"
                        class="size-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.07]"
                      />
                    ) : (
                      <div class="relative grid size-full place-items-center">
                        <div class="stars"></div>
                        <span class="grid size-24 place-items-center rounded-full bg-cacao-2 text-cian shadow-[0_0_50px_-6px_var(--color-cian)]">
                          <CupSoda size={44} stroke-width={1.6} aria-hidden="true" />
                        </span>
                      </div>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <h2 class="text-[1.5rem]">{title}</h2>
                    <p class="mt-2 flex-1 text-chocolate/75">{t(`menu_${category.id}_desc` as UIKey)}</p>
                    {category.items?.length ? (
                      <ul class="mt-4 space-y-2 text-sm">
                        {category.items.map((item) => (
                          <li class="flex items-baseline justify-between gap-3 border-b border-dashed border-chocolate/20 pb-1">
                            <span>{item.name}</span>
                            {item.price && <strong>{item.price}</strong>}
                          </li>
                        ))}
                      </ul>
                    ) : null}
                    <p class="mt-4 text-sm font-semibold text-chocolate/70">{t('menu_price_ask')}</p>
                    <a
                      href={whatsappLink(t('menu_quote_message', { item: title }))}
                      target="_blank"
                      rel="noopener"
                      class="btn btn-primary mt-4 w-full"
                    >
                      {t('menu_cta')}
                      <ArrowUpRight size={18} aria-hidden="true" />
                    </a>
                  </div>
                </article>
              </li>
            );
          })
        }
      </ul>
      <p class="mt-10 text-center text-chocolate/70" data-reveal>{t('menu_note')}</p>
    </div>
  </section>

  <MacaronKnock lang={lang} />
  <CtaBand lang={lang} />
</Layout>
