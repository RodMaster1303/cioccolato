---
import '../styles/global.css';
import { Font, Image } from 'astro:assets';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Preloader from '../components/layout/Preloader.astro';
import FloatingWhatsApp from '../components/layout/FloatingWhatsApp.astro';
import { bakerySchema } from '../lib/schema';
import { sprite } from '../lib/assets';
import { DEFAULT_LANG, LANGS, LOCALE_META, pathFor, useTranslations, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey | '404';
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}

const { lang, page, title, description, jsonLd = [] } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://cioccolato.netlify.app');
const noindex = page === '404' || import.meta.env.PUBLIC_NOINDEX === '1';
const indexable = page !== '404';
const canonical = indexable ? new URL(pathFor(lang, page), site).href : undefined;
const alternates = indexable
  ? LANGS.map((code) => ({ hreflang: LOCALE_META[code].htmlLang, href: new URL(pathFor(code, page), site).href }))
  : [];
const xDefault = indexable ? new URL(pathFor(DEFAULT_LANG, page), site).href : undefined;
const ogImage = new URL('/og.jpg', site).href;
const schemas = [bakerySchema(lang, site), ...jsonLd];
---

<!doctype html>
<html lang={LOCALE_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cioccolato" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('hero_image_alt')} />
    <meta property="og:locale" content={LOCALE_META[lang].ogLocale} />
    {LANGS.filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={LOCALE_META[code].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#140a0f" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-inter" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-fraunces" preload={[{ subset: 'latin' }]} />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var navigation = window.performance && performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
        var reload = !!navigation && navigation.type === 'reload';
        var internal = false;
        try {
          internal = document.referrer !== '' && new URL(document.referrer).origin === window.location.origin;
        } catch (error) {}
        if (reduce || (internal && !reload)) return;
        root.classList.add('intro-active');
        var LOGO = 1250;
        var CAST = 1560;
        var PATIENCE = 1800;
        var CLOSE = 900;
        var phase = 0;
        var timer = 0;
        var later = function (task, ms) {
          clearTimeout(timer);
          timer = setTimeout(task, ms);
        };
        var fly = function () {
          var trio = document.querySelector('[data-hero-trio]');
          if (!trio || !Element.prototype.animate) return;
          var slots = document.querySelectorAll('#preloader .pl-slot');
          var moved = 0;
          for (var index = 0; index < slots.length; index++) {
            var slot = slots[index];
            var target = trio.querySelector('.cat[data-cat="' + slot.getAttribute('data-cat') + '"]');
            if (!target) continue;
            var from = slot.getBoundingClientRect();
            var to = target.getBoundingClientRect();
            if (!from.width || !to.width) continue;
            var dx = to.left - from.left;
            var dy = to.top - from.top;
            var scale = to.width / from.width;
            var lift = Math.min(90, 30 + Math.abs(dx) * 0.12);
            slot.animate(
              [
                { transformOrigin: '0 0', transform: 'translate(0px, 0px) scale(1)' },
                { transformOrigin: '0 0', transform: 'translate(' + dx * 0.5 + 'px,' + (dy * 0.5 - lift) + 'px) scale(' + (1 + scale) / 2 + ')', offset: 0.5 },
                { transformOrigin: '0 0', transform: 'translate(' + dx + 'px,' + dy + 'px) scale(' + scale + ')' },
              ],
              { duration: 760, delay: index * 45, easing: 'cubic-bezier(0.6, 0, 0.25, 1)', fill: 'forwards' },
            );
            moved += 1;
          }
          if (moved) root.classList.add('intro-handoff');
        };
        var close = function (handoff) {
          if (phase === 3) return;
          phase = 3;
          clearTimeout(timer);
          if (handoff) fly();
          root.classList.remove('intro-active');
          root.classList.add('intro-closing');
          setTimeout(function () {
            root.classList.remove('intro-closing');
            root.classList.remove('intro-handoff');
            window.dispatchEvent(new Event('intro:done'));
          }, CLOSE);
        };
        var ready = function () {
          var images = document.querySelectorAll('#preloader .cat-pose');
          if (!images.length) return false;
          for (var index = 0; index < images.length; index++) {
            if (!images[index].complete || !images[index].naturalWidth) return false;
          }
          return true;
        };
        var cast = function () {
          if (phase !== 1) return;
          phase = 2;
          root.classList.add('intro-cast');
          later(function () {
            close(true);
          }, CAST);
        };
        var afterLogo = function () {
          var deadline = Date.now() + PATIENCE;
          var poll = function () {
            if (phase !== 1) return;
            if (ready()) return cast();
            if (Date.now() > deadline) return close(false);
            later(poll, 80);
          };
          poll();
        };
        var start = function () {
          if (phase !== 0) return;
          phase = 1;
          root.classList.add('intro-run');
          later(afterLogo, LOGO);
        };
        var skip = function () {
          root.classList.add('intro-skip');
          close(false);
        };
        requestAnimationFrame(function () {
          requestAnimationFrame(start);
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') skip();
        });
        document.addEventListener('DOMContentLoaded', function () {
          var pre = document.getElementById('preloader');
          if (pre) pre.addEventListener('click', skip);
        });
      })();
    </script>

    {schemas.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[210] focus:rounded-full focus:bg-rosa-brillo focus:px-5 focus:py-3 focus:text-sm focus:font-bold focus:text-cacao"
    >
      {t('skip_to_content')}
    </a>
    <Preloader lang={lang} />
    <div id="scroll-progress" aria-hidden="true">
      <span class="sp-line"></span>
      <span class="sp-ball">
        <Image src={sprite('obj-yarn-pink')} alt="" width={26} densities={[1, 2]} loading="eager" class="sprite h-auto w-full" />
      </span>
    </div>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <FloatingWhatsApp lang={lang} />
    <script>
      import '../scripts/site';
      import '../scripts/michis';
    </script>
  </body>
</html>

<style is:global>
  #scroll-progress {
    --progress: 0;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    height: 3px;
    pointer-events: none;
  }

  .sp-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-rosa-brillo), var(--color-ambar), var(--color-cian));
    transform: scaleX(var(--progress));
    transform-origin: left;
  }

  .sp-ball {
    position: absolute;
    top: -10px;
    left: calc((100% - 26px) * var(--progress));
    width: 26px;
    opacity: clamp(0, calc(var(--progress) * 60), 1);
    transform: rotate(calc(var(--progress) * 2880deg));
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-rosa-brillo) 70%, transparent));
  }
</style>
