---
import Layout from '../layouts/Layout.astro';
import Michi from '../components/ui/Michi.astro';
import { pathFor, useTranslations } from '../i18n';

const lang = 'es' as const;
const t = useTranslations(lang);
const other = useTranslations('en');
---

<Layout lang={lang} page="404" title={`${t('page_title_404')} | Cioccolato`} description={t('meta_description_404')}>
  <section class="surface-dark relative isolate flex min-h-[100svh] items-center overflow-hidden pt-24">
    <div class="stars"></div>
    <div class="pointer-events-none absolute left-1/2 top-1/3 -z-10 size-[30rem] -translate-x-1/2 rounded-full bg-rosa/25 blur-[120px]"></div>
    <div class="container-site grid items-center gap-8 pb-20 md:grid-cols-2">
      <div class="text-center md:text-left">
        <p class="font-display text-[clamp(5rem,16vw,10rem)] font-semibold leading-none text-rosa-brillo">404</p>
        <h1 class="mt-2 text-[clamp(1.8rem,4vw,2.8rem)]">{t('not_found_title')}</h1>
        <p class="lead mt-4">{t('not_found_text')}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4 md:justify-start">
          <a href={pathFor(lang, 'home')} class="btn btn-primary">{t('not_found_cta')}</a>
          <a href={pathFor('en', 'home')} class="btn btn-ghost" hreflang="en" lang="en">{other('not_found_cta')}</a>
        </div>
      </div>
      <div class="flex justify-center">
        <Michi michi="pivi" poses={['crouch', 'pounce']} width={420} interact="none" />
      </div>
    </div>
  </section>
</Layout>
